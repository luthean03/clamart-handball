{
  "expo": {
    "name": "Clamart Handball",
    "slug": "clamart-handball",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo-clamart.png",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "fr.clamarthandball.app",
      "edgeToEdgeEnabled": true,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo-clamart.png",
        "backgroundColor": "#DB0000"
      },
      "blockedPermissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "@react-native-firebase/app",
      "expo-dev-client",
      ["expo-build-properties", { "ios": { "useFrameworks": "static" } }],
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo-clamart.png",
          "imageWidth": 160,
          "backgroundColor": "#DB0000"
        }
      ]
    ],
    "scheme": "clamart",
    "extra": {
      "urlDonnees": "https://luthean03.github.io/clamart-handball/data/club.json"
    }
  }
}
