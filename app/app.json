{
  "expo": {
    "name": "Clamart Handball",
    "slug": "clamart-handball",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icone/icone.png",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "fr.clamarthandball.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icone/premier-plan.png",
        "monochromeImage": "./assets/icone/monochrome.png",
        "backgroundColor": "#DB0000"
      },
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "@react-native-firebase/app",
      "expo-dev-client",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "./plugins/icone-notification",
        {
          "dossier": "./assets/notification",
          "couleur": "#00000000"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo-clamart.png",
          "imageWidth": 160,
          "backgroundColor": "#DB0000"
        }
      ]
    ],
    "scheme": "clamart",
    "extra": {
      "urlDonnees": "https://luthean03.github.io/clamart-handball/data/club.json",
      "router": {},
      "eas": {
        "projectId": "dce6da70-736f-4f4c-bff9-b5ddde56e3a0"
      }
    }
  }
}
